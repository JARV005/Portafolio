# ─────────────────────────────────────────────────────────────
# Portafolio Johan Rivera — variables de entorno
# Copia este archivo a .env.local para desarrollo o configura
# los valores en Vercel (Production + Preview).
# ─────────────────────────────────────────────────────────────

# API key de Resend. Crea una en https://resend.com (Developers → API Keys).
# Sin esta variable, el endpoint /api/contact responde 503 y el formulario
# del sitio pinta un mensaje amable invitando a usar el email.
RESEND_API_KEY=

# Dirección de destino que recibe los correos del formulario de contacto.
# Debe ser una bandeja a la que Johan tenga acceso.
CONTACT_TO=

# Opcional. Dirección "From" verificada en Resend. Si se omite, se usa
# onboarding@resend.dev (solo sirve para probar durante el onboarding).
# Para producción, verifica tu dominio en Resend y pon aquí algo como
# "Johan Rivera <contacto@johan-rv.site>".
CONTACT_FROM=
